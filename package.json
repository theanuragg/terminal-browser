{
  "name": "terminal-graphics-engine",
  "private": true,
  "scripts": {
    "browser": "pnpm --filter terminal-browser start",
    "build:dist": "node init && scripts/release.sh \"local-$(git rev-parse --short HEAD)\"",
    "install:dist": "scripts/install-local.sh",
    "dist": "pnpm build:dist && pnpm install:dist",
    "release:patch": "scripts/tag-release.sh patch",
    "release:minor": "scripts/tag-release.sh minor",
    "release:major": "scripts/tag-release.sh major"
  },
  "packageManager": "pnpm@10.13.1",
  "devDependencies": {
    "dotenv": "^8.2.0",
    "esbuild": "^0.25.0",
    "node-fetch": "^3.3.2"
  }
}
